{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "mode": {
      "enum": [
        "aggregated",
        "disaggregated"
      ]
    },
    "slots": {
      "enum": [
        2,
        4
      ]
    },
    "scheduler": {
      "enum": [
        "serial",
        "token-budget"
      ]
    },
    "namespace": {
      "type": "string",
      "minLength": 1
    }
  },
  "if": {
    "properties": {
      "scheduler": {
        "const": "token-budget"
      }
    }
  },
  "then": {
    "properties": {
      "slots": {
        "const": 4
      },
      "settings": {
        "required": [
          "TOKEN_BUDGET",
          "MAX_NUM_SEQS",
          "MAX_KV_TOKENS"
        ]
      }
    }
  }
}
