{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "scenario": {
      "enum": [
        "availability",
        "hpa"
      ]
    },
    "backend": {
      "enum": [
        "llamacpp",
        "transformers"
      ]
    },
    "namespace": {
      "type": "string",
      "minLength": 1
    },
    "loadReplicas": {
      "type": "integer",
      "minimum": 0
    }
  }
}
