ARG CUDA_IMAGE=nvidia/cuda:12.8.1-devel-ubuntu24.04
FROM ${CUDA_IMAGE} AS gpu-builder
ENV DEBIAN_FRONTEND=noninteractive CMAKE_ARGS="-DGGML_CUDA=on -DGGML_NATIVE=OFF -DCMAKE_CUDA_ARCHITECTURES=75" CMAKE_BUILD_PARALLEL_LEVEL=8
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv python3-dev build-essential cmake git && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/venv
COPY llamacpp/base/requirements.txt /tmp/llama-requirements.txt
RUN /opt/venv/bin/pip install --no-cache-dir -r /tmp/llama-requirements.txt && /opt/venv/bin/pip check

FROM nvidia/cuda:12.8.1-runtime-ubuntu24.04 AS gpu-runtime-llamacpp
ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 HF_HUB_OFFLINE=1 HF_HUB_DISABLE_TELEMETRY=1 PATH="/opt/venv/bin:$PATH"
RUN apt-get update && apt-get install -y --no-install-recommends python3 libgomp1 ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=gpu-builder /opt/venv /opt/venv
WORKDIR /app
COPY inference/*.py /app/inference/
COPY llamacpp/__init__.py /app/llamacpp/
COPY llamacpp/base/*.py /app/llamacpp/base/
RUN getent group 1000 >/dev/null || groupadd --gid 1000 inference; \
    getent passwd 1000 >/dev/null || useradd --uid 1000 --gid 1000 --no-create-home --home-dir /tmp inference
USER 1000:1000
EXPOSE 8000
ENTRYPOINT ["python", "-m", "llamacpp.base.server"]

FROM gpu-runtime-llamacpp AS base-llamacpp-gpu

FROM gpu-runtime-llamacpp AS enhanced-batch-llamacpp-gpu
COPY llamacpp/batch/*.py /app/llamacpp/batch/
ENTRYPOINT ["python", "-m", "llamacpp.batch.server"]

FROM gpu-runtime-llamacpp AS enhanced-cache-llamacpp-gpu
COPY llamacpp/cache/*.py /app/llamacpp/cache/
ENTRYPOINT ["python", "-m", "llamacpp.cache.server"]

FROM python:3.12-slim-bookworm AS gpu-runtime-transformers
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 HF_HUB_OFFLINE=1 HF_HUB_DISABLE_TELEMETRY=1 HF_HOME=/tmp/huggingface OMP_NUM_THREADS=4 TORCHINDUCTOR_CACHE_DIR=/tmp/torchinductor
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY huggingface/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir torch==2.10.0 --index-url https://download.pytorch.org/whl/cu128 \
    && pip install --no-cache-dir -r /tmp/requirements.txt && pip check \
    && python -c "import torch; assert torch.version.cuda is not None"
COPY inference/*.py /app/inference/
COPY huggingface/__init__.py /app/huggingface/
COPY huggingface/runtime/*.py /app/huggingface/runtime/
RUN groupadd --gid 1000 inference && useradd --uid 1000 --gid 1000 --no-create-home --home-dir /tmp inference
USER 1000:1000
EXPOSE 8000

FROM gpu-runtime-transformers AS gpu-runtime-llama
COPY huggingface/llama/*.py /app/huggingface/llama/
COPY huggingface/llama/base/*.py /app/huggingface/llama/base/
ENTRYPOINT ["python", "-m", "huggingface.llama.base.server"]

FROM gpu-runtime-llama AS transformers-base-gpu

FROM gpu-runtime-llama AS transformers-pd-gpu
USER 0
COPY huggingface/llama/inference_distributed/requirements.txt /tmp/pd-requirements.txt
RUN pip install --no-cache-dir -r /tmp/pd-requirements.txt && pip check
COPY huggingface/llama/inference_distributed/*.py /app/huggingface/llama/inference_distributed/
USER 1000:1000
ENTRYPOINT ["python", "-m", "huggingface.llama.inference_distributed.server"]

FROM gpu-runtime-llama AS transformers-enhanced-batch-gpu
COPY huggingface/llama/batch/*.py /app/huggingface/llama/batch/
COPY huggingface/llama/batch/gpu/*.py /app/huggingface/llama/batch/gpu/
ENTRYPOINT ["python", "-m", "huggingface.llama.batch.gpu.server"]

FROM gpu-runtime-llama AS transformers-enhanced-cache-gpu
COPY huggingface/llama/cache/*.py /app/huggingface/llama/cache/
ENTRYPOINT ["python", "-m", "huggingface.llama.cache.server"]

FROM gpu-runtime-transformers AS transformers-mamba-base-gpu
COPY huggingface/mamba/*.py /app/huggingface/mamba/
COPY huggingface/mamba/base/*.py /app/huggingface/mamba/base/
ENTRYPOINT ["python", "-m", "huggingface.mamba.base.server"]

FROM transformers-mamba-base-gpu AS transformers-mamba-cache-gpu
COPY huggingface/mamba/cache/*.py /app/huggingface/mamba/cache/
ENTRYPOINT ["python", "-m", "huggingface.mamba.cache.server"]

FROM gpu-runtime-transformers AS transformers-hybrid-gpu
COPY huggingface/jamba/*.py /app/huggingface/jamba/
COPY huggingface/jamba/base/*.py /app/huggingface/jamba/base/
COPY huggingface/jamba/hybrid/*.py /app/huggingface/jamba/hybrid/
ENTRYPOINT ["python", "-m", "huggingface.jamba.hybrid.server"]
