{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "llama-base",
        "namespace": "default"
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app": "llama-base"
          }
        },
        "strategy": {
          "type": "Recreate"
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "llama-base"
            }
          },
          "spec": {
            "containers": [
              {
                "args": [
                  "--model",
                  "/model/qwen2.5-0.5b-instruct-q4_k_m.gguf",
                  "--served-model-name",
                  "Qwen/Qwen2.5-0.5B-Instruct",
                  "--n-threads",
                  "12",
                  "--n-ctx",
                  "1024",
                  "--max-input-tokens",
                  "768",
                  "--max-output-tokens",
                  "128",
                  "--default-output-tokens",
                  "32"
                ],
                "image": "local/llama-base:0.1.0",
                "imagePullPolicy": "Never",
                "livenessProbe": {
                  "httpGet": {
                    "path": "/healthz",
                    "port": "http"
                  },
                  "periodSeconds": 10
                },
                "name": "api",
                "ports": [
                  {
                    "containerPort": 8000,
                    "name": "http"
                  }
                ],
                "readinessProbe": {
                  "httpGet": {
                    "path": "/readyz",
                    "port": "http"
                  }
                },
                "resources": {
                  "limits": {
                    "cpu": "12",
                    "memory": "16Gi"
                  },
                  "requests": {
                    "cpu": "12",
                    "memory": "16Gi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  },
                  "readOnlyRootFilesystem": true
                },
                "startupProbe": {
                  "failureThreshold": 60,
                  "httpGet": {
                    "path": "/readyz",
                    "port": "http"
                  },
                  "periodSeconds": 5
                },
                "volumeMounts": [
                  {
                    "mountPath": "/model",
                    "name": "model",
                    "readOnly": true
                  },
                  {
                    "mountPath": "/tmp",
                    "name": "tmp"
                  }
                ]
              }
            ],
            "securityContext": {
              "runAsGroup": 1000,
              "runAsNonRoot": true,
              "runAsUser": 1000
            },
            "terminationGracePeriodSeconds": 60,
            "volumes": [
              {
                "hostPath": {
                  "path": "/models/qwen2.5-0.5b",
                  "type": "Directory"
                },
                "name": "model"
              },
              {
                "emptyDir": {
                  "sizeLimit": "1Gi"
                },
                "name": "tmp"
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "llama-base",
        "namespace": "default"
      },
      "spec": {
        "ports": [
          {
            "name": "http",
            "port": 8000,
            "targetPort": "http"
          }
        ],
        "selector": {
          "app": "llama-base"
        }
      }
    }
  ]
}
