{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "metadata": {
        "name": "aiperf-results-128",
        "namespace": "default"
      },
      "spec": {
        "accessModes": [
          "ReadWriteOnce"
        ],
        "resources": {
          "requests": {
            "storage": "1Gi"
          }
        },
        "storageClassName": "standard"
      }
    },
    {
      "apiVersion": "batch/v1",
      "kind": "Job",
      "metadata": {
        "labels": {
          "app": "aiperf",
          "benchmark": "aiperf-cpu"
        },
        "name": "aiperf-128",
        "namespace": "default"
      },
      "spec": {
        "activeDeadlineSeconds": 14400,
        "backoffLimit": 0,
        "template": {
          "metadata": {
            "labels": {
              "app": "aiperf",
              "benchmark": "aiperf-cpu"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "containers": [
              {
                "args": [
                  "profile",
                  "--model",
                  "$(MODEL_ID)",
                  "--tokenizer",
                  "/tokenizer",
                  "--url",
                  "$(API_URL)",
                  "--endpoint-type",
                  "chat",
                  "--streaming",
                  "--use-server-token-count",
                  "--sequence-distribution",
                  "64,32:50;256,64:50",
                  "--num-dataset-entries",
                  "$(DATASET_ENTRIES)",
                  "--random-seed",
                  "42",
                  "--parameter-sweep-same-seed",
                  "--dataset-sampling-strategy",
                  "sequential",
                  "--extra-inputs",
                  "ignore_eos:true",
                  "--concurrency",
                  "$(CONCURRENCIES)",
                  "--workers-max",
                  "1",
                  "--warmup-request-count",
                  "2",
                  "--warmup-concurrency",
                  "1",
                  "--request-count",
                  "100",
                  "--request-timeout-seconds",
                  "3600",
                  "--no-server-metrics",
                  "--ui",
                  "none",
                  "--artifact-dir",
                  "/results/$(POD_NAME)"
                ],
                "env": [
                  {
                    "name": "DATASET_ENTRIES",
                    "value": "128"
                  },
                  {
                    "name": "POD_NAME",
                    "valueFrom": {
                      "fieldRef": {
                        "fieldPath": "metadata.name"
                      }
                    }
                  },
                  {
                    "name": "CONCURRENCIES",
                    "value": "1,2,4,8"
                  },
                  {
                    "name": "API_URL",
                    "value": "http://llama-base:8000"
                  },
                  {
                    "name": "MODEL_ID",
                    "value": "Qwen/Qwen2.5-0.5B-Instruct"
                  }
                ],
                "image": "local/aiperf:0.12.0",
                "imagePullPolicy": "Never",
                "name": "aiperf",
                "resources": {
                  "limits": {
                    "cpu": "1",
                    "memory": "1Gi"
                  },
                  "requests": {
                    "cpu": "1",
                    "memory": "1Gi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  },
                  "readOnlyRootFilesystem": true
                },
                "volumeMounts": [
                  {
                    "mountPath": "/tokenizer",
                    "name": "tokenizer",
                    "readOnly": true
                  },
                  {
                    "mountPath": "/results",
                    "name": "results"
                  },
                  {
                    "mountPath": "/tmp",
                    "name": "tmp"
                  }
                ]
              }
            ],
            "restartPolicy": "Never",
            "securityContext": {
              "fsGroup": 1000,
              "runAsGroup": 1000,
              "runAsNonRoot": true,
              "runAsUser": 1000
            },
            "terminationGracePeriodSeconds": 60,
            "volumes": [
              {
                "hostPath": {
                  "path": "/models/qwen2.5-0.5b/tokenizer",
                  "type": "Directory"
                },
                "name": "tokenizer"
              },
              {
                "name": "results",
                "persistentVolumeClaim": {
                  "claimName": "aiperf-results-128"
                }
              },
              {
                "emptyDir": {
                  "sizeLimit": "1Gi"
                },
                "name": "tmp"
              }
            ],
            "nodeSelector": {
              "kubernetes.io/hostname": "local-k8s-worker2"
            }
          }
        },
        "ttlSecondsAfterFinished": 3600
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Pod",
      "metadata": {
        "name": "aiperf-results-128",
        "namespace": "default"
      },
      "spec": {
        "automountServiceAccountToken": false,
        "containers": [
          {
            "command": [
              "sh",
              "-c",
              "while :; do sleep 3600; done"
            ],
            "image": "busybox:1.37.0",
            "imagePullPolicy": "IfNotPresent",
            "name": "reader",
            "resources": {
              "limits": {
                "memory": "64Mi"
              },
              "requests": {
                "cpu": "10m",
                "memory": "16Mi"
              }
            },
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              },
              "readOnlyRootFilesystem": true
            },
            "volumeMounts": [
              {
                "mountPath": "/results",
                "name": "results",
                "readOnly": true
              }
            ]
          }
        ],
        "securityContext": {
          "fsGroup": 1000,
          "runAsGroup": 1000,
          "runAsNonRoot": true,
          "runAsUser": 1000
        },
        "volumes": [
          {
            "name": "results",
            "persistentVolumeClaim": {
              "claimName": "aiperf-results-128"
            }
          }
        ],
        "nodeSelector": {
          "kubernetes.io/hostname": "local-k8s-worker2"
        }
      }
    }
  ]
}
